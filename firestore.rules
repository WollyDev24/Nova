rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wollywoll8844@gmail.com' ||
        request.auth.token.email == 'balthasar.gasmann@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Community Wallpapers
    match /community_wallpapers/{wallpaperId} {
      // Anyone can read and browse community wallpapers
      allow read: if true;

      // Only authenticated users can publish wallpapers
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 60;

      // Authors can delete their own wallpapers, or Admins can delete any wallpaper
      allow delete: if request.auth != null && (resource.data.authorId == request.auth.uid || isAdmin());

      // Likes/downloads increments by users, or Admins can update status / review fields
      allow update: if request.auth != null && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'downloadsCount'])
      );
    }

    // User Private Data & Liked Wallpapers
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /liked/{wallpaperId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
