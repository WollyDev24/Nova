rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Community Wallpapers (Videos & WebP Thumbnails)
    match /community_wallpapers/{wallpaperId}/{fileName} {
      // Anyone can read and stream wallpapers
      allow read: if true;

      // Authenticated users can upload:
      // - Max video size: 30MB (MP4)
      // - Max thumbnail size: 2MB (WebP/JPEG)
      allow write: if request.auth != null
                   && (
                     (fileName == "video.mp4" && request.resource.size < 30 * 1024 * 1024 && request.resource.contentType.matches('video/.*')) ||
                     (fileName == "thumbnail.webp" && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*'))
                   );

      // Authors can delete their files
      allow delete: if request.auth != null
                    && resource.metadata.authorId == request.auth.uid;
    }
  }
}
